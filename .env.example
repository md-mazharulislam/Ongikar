# ── Copy this file to `.env` in the project root before running docker compose ──
# This file is ONLY used by Docker Compose (docker-compose.yml /
# docker-compose.replica.yml / docker-compose.atlas.yml) run from the
# project root. It is separate from backend/.env.example and
# frontend/.env.example, which are only needed if you run those two
# apps manually without Docker (see README "Method 2").

# ---- MongoDB ----
# Option A (default, docker-compose.yml): bundled standalone MongoDB
#   container. Leave MONGO_URI as-is — it points at the "mongo" service by
#   its Docker network name.
MONGO_URI=mongodb://mongo:27017/ongikar

# Option B (docker-compose.replica.yml): local single-node replica set for
#   full transaction support. If using that file instead, set:
#   MONGO_URI=mongodb://mongo:27017/ongikar?replicaSet=rs0

# Option C (docker-compose.atlas.yml): real MongoDB Atlas in the cloud.
#   Replace MONGO_URI with your Atlas connection string, e.g.:
#   MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/ongikar

# ---- Mongo Express (web UI to browse the database) ----
# Open http://localhost:8081 to browse databases/collections/documents in
# your browser. Only used by docker-compose.yml and docker-compose.replica.yml
# (not needed for docker-compose.atlas.yml — use the Atlas web dashboard's
# own "Browse Collections" instead). These defaults are fine for local
# testing only; change them before exposing this port beyond your own machine.
ME_BASICAUTH_USERNAME=admin
ME_BASICAUTH_PASSWORD=admin123
MONGO_EXPRESS_PORT=8081

# ---- Backend ----
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d
BACKEND_PORT=5000
CLIENT_URL=http://localhost:8080

# First-run bootstrap admin account (auto-created if no admin exists yet).
# Change these before deploying anywhere beyond your own machine.
ADMIN_PHONE=+8801900000000
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Ongikar Admin

# ---- Frontend ----
FRONTEND_PORT=8080
# Base path the browser calls — the Nginx container proxies /api to the backend,
# so this should normally stay as /api.
VITE_API_URL=/api
